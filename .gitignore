__pycache__/
*.pyc
*.pyo
.DS_Store
*.whl
*.egg-info/
build/
.env
.zipbuild/
dist/
tmp.iconset/
inf_wheel/
.claude/
# The Windows Infineon wheel is committed on purpose: CI has to install it to
# build a radar-capable exe, and it is MIT-licensed (see vendor/). Every other
# wheel stays ignored by the *.whl rule above.
!vendor/*.whl
# Base model weights, fetched at build time by tools/fetch_base_model.py.
models/
# *.spec intentionally NOT ignored — main.spec is source-controlled so
# GitHub Actions and other build machines can find it via git clone.